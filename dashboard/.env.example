# Vercel-only server variables. Never prefix these with NEXT_PUBLIC_.
SAFESPEND_BACKEND_ORIGIN=https://safespend-runtime.example.onrender.com
SAFESPEND_BACKEND_TOKEN=replace-with-the-same-64-character-token-used-on-render
SAFESPEND_DASHBOARD_PASSWORD=replace-with-a-long-random-password
SAFESPEND_DASHBOARD_USER=founder

# Render-only server variables for free-tier durable state. Never expose the service-role key.
SUPABASE_URL=https://replace-with-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace-with-the-server-only-secret-key
